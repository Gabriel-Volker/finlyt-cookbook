{
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "reason_code", "reason", "changes", "review_items"],
  "properties": {
    "status": {"type": "string", "enum": ["ready", "needs_review", "unavailable"]},
    "reason_code": {
      "type": ["string", "null"],
      "enum": ["insufficient_information", "no_viable_substitute", null]
    },
    "reason": {"type": ["string", "null"]},
    "changes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "before", "after", "reason"],
        "properties": {
          "path": {"type": "string"},
          "before": {"type": "string"},
          "after": {"type": ["string", "null"]},
          "reason": {"type": "string"}
        }
      }
    },
    "review_items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "reason"],
        "properties": {
          "path": {"type": "string"},
          "reason": {"type": "string"}
        }
      }
    }
  }
}
