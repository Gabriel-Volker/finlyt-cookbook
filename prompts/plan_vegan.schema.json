{
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "reason_code", "reason", "changes", "review_items"],
  "properties": {
    "status": {"type": "string", "enum": ["ready", "needs_review", "unavailable"]},
    "reason_code": {
      "type": ["string", "null"],
      "enum": ["insufficient_information", "no_viable_substitute", null]
    },
    "reason": {"type": ["string", "null"]},
    "changes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "before", "after", "reason", "replacement_measure"],
        "properties": {
          "path": {"type": "string"},
          "before": {"type": "string"},
          "after": {"type": ["string", "null"]},
          "reason": {"type": "string"},
          "replacement_measure": {
            "anyOf": [
              {"type": "null"},
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["quantity", "unit", "basis"],
                "properties": {
                  "quantity": {"type": "string"},
                  "unit": {"type": ["string", "null"]},
                  "basis": {"type": "string"}
                }
              }
            ]
          }
        }
      }
    },
    "review_items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "reason"],
        "properties": {
          "path": {"type": "string"},
          "reason": {"type": "string"}
        }
      }
    }
  }
}
